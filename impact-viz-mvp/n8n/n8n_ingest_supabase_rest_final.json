{
  "name": "Impact Ingest (OpenAI + Supabase, stable)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "impact/ingest",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "Webhook_Trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "functionCode": "const b = items[0].json || {};\nif (!b.uploadId) throw new Error('Missing uploadId');\nreturn [{ json: {\n  uploadId: b.uploadId,\n  fileName: b.fileName || 'report',\n  supabaseUrl: b.supabaseUrl,\n  serviceRole: b.serviceRole,\n  portfolio_id: b.portfolio_id || null,\n  storagePath: b.storagePath || null,\n  autoApprove: !!b.autoApprove\n}}];"
      },
      "id": "Prepare_Payload",
      "name": "Prepare Payload",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "requestMethod": "PATCH",
        "url": "={{ $json.supabaseUrl }}/rest/v1/uploads?id=eq.{{$json.uploadId}}",
        "jsonParameters": true,
        "options": {},
        "sendBinaryData": false,
        "headerParametersJson": "={\n  \"Authorization\": \"Bearer \" + $json.serviceRole,\n  \"apikey\": $json.serviceRole,\n  \"Content-Type\": \"application/json\"\n}",
        "bodyParametersJson": "{\"status\":\"processing\"}"
      },
      "id": "Uploads_Processing",
      "name": "Uploads → processing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "functionCode": "const ctx = $items('Prepare_Payload')[0].json;\nconst text = `EOY report for portfolio ${ctx.portfolio_id || 'N/A'}\\nWACI: 12.3 tCO2e/$M\\nFEMISS: 451.0 tCO2e\\nRE_MWH: 8800 MWh`;\nreturn [{ json: { text, ctx } }];"
      },
      "id": "Build_Report_Text",
      "name": "Build Report Text (demo)",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "mode": "chat",
        "text": "Extract KPI facts from the report text below.\\nReturn STRICT JSON with a single key 'facts', which is an array of objects with fields: metric_code, value, unit, period_start, period_end, source, verification_level, data_quality_score, holding_id, holding_name, sector, country. If uncertain, use null.\\n\\nText:\\n{{$json.text}}",
        "additionalFields": {
          "systemMessage": "You are a deterministic data extraction model for impact investing. Return only valid JSON. Valid metric_code values include: WACI, FEMISS, RE_MWH, JOBS_FTE, WOM_LEAD_PCT, REV_IMPACT_PCT, HH_REACHED.",
          "temperature": 0,
          "responseFormat": "json_object"
        }
      },
      "id": "OpenAI_Extract",
      "name": "OpenAI Extract",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [1140, 300],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_API_CREDENTIALS_PLACEHOLDER"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "let content;\nconst j = items[0].json;\nif (j?.data?.choices?.[0]?.message?.content) content = j.data.choices[0].message.content;\nelse if (j?.choices?.[0]?.message?.content) content = j.choices[0].message.content;\nelse if (j?.facts) return items;\nif (typeof content !== 'string') throw new Error('OpenAI content missing');\nlet payload;\ntry { payload = JSON.parse(content); } catch (e) { throw new Error('OpenAI did not return JSON: ' + content); }\nif (!payload || !payload.facts) throw new Error('Expected { facts: [...] }');\nreturn [{ json: payload }];"
      },
      "id": "Parse_OpenAI_JSON",
      "name": "Parse OpenAI JSON",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1360, 300]
    },
    {
      "parameters": {
        "functionCode": "const codes = Array.from(new Set((items[0].json.facts || []).map(f => f.metric_code).filter(Boolean)));\nreturn codes.map(c => ({ json: { code: c, name: c, unit: null, directionality: null, aggregation_function: null } }));"
      },
      "id": "Collect_Metric_Codes",
      "name": "Collect Metric Codes",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "={{ $items(\"Prepare_Payload\")[0].json.supabaseUrl }}/rest/v1/metrics",
        "jsonParameters": true,
        "options": {},
        "sendBinaryData": false,
        "headerParametersJson": "={\n  \"Authorization\": \"Bearer \" + $items(\"Prepare_Payload\")[0].json.serviceRole,\n  \"apikey\": $items(\"Prepare_Payload\")[0].json.serviceRole,\n  \"Content-Type\": \"application/json\",\n  \"Prefer\": \"resolution=merge-duplicates\"\n}",
        "bodyParametersJson": "={{ $items().map(i => i.json) }}"
      },
      "id": "Upsert_Metrics",
      "name": "Upsert Metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1780, 300]
    },
    {
      "parameters": {
        "functionCode": "const ctx = $items('Prepare_Payload')[0].json;\nconst facts = $items('Parse_OpenAI_JSON')[0].json.facts || [];\nconst now = new Date().toISOString();\nconst rows = facts.map(f => ({\n  investee_id: f.investee_id || null,\n  holding_id:  f.holding_id  || null,\n  metric_code: f.metric_code || null,\n  period_start: f.period_start || null,\n  period_end:   f.period_end   || now.slice(0,10),\n  value: (f.value != null ? Number(f.value) : null),\n  source: f.source || 'LLM Extract',\n  verification_level: f.verification_level || 'Issuer Reported',\n  data_quality_score: (f.data_quality_score != null ? Number(f.data_quality_score) : 0.6),\n  last_updated: now,\n  staged_by: 'n8n',\n  note: `upload:${ctx.uploadId};portfolio:${ctx.portfolio_id ?? 'N/A'}`\n}));\nif (rows.length === 0) rows.push({\n  investee_id: null, holding_id: null, metric_code: 'PLACEHOLDER_DOC_COUNT',\n  period_start: null, period_end: now.slice(0,10), value: 1,\n  source: 'parser', verification_level: 'System', data_quality_score: 1.0,\n  last_updated: now, staged_by: 'n8n', note: `upload:${ctx.uploadId};placeholder`\n});\nreturn [{ json: { rows, ctx } }];"
      },
      "id": "Normalize_Staging",
      "name": "Normalize → staging_metric_facts",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [2000, 300]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "={{ $json.ctx.supabaseUrl }}/rest/v1/staging_metric_facts",
        "jsonParameters": true,
        "options": {},
        "sendBinaryData": false,
        "headerParametersJson": "={\n  \"Authorization\": \"Bearer \" + $json.ctx.serviceRole,\n  \"apikey\": $json.ctx.serviceRole,\n  \"Content-Type\": \"application/json\",\n  \"Prefer\": \"return=representation\"\n}",
        "bodyParametersJson": "={{ $json.rows }}"
      },
      "id": "Insert_Staging",
      "name": "Insert staging_metric_facts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [2220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $items(\"Prepare_Payload\")[0].json.autoApprove === true }}"
            }
          ]
        }
      },
      "id": "If_AutoApprove",
      "name": "If autoApprove",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2440, 300]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "={{ $items(\"Prepare_Payload\")[0].json.supabaseUrl }}/rest/v1/metric_facts",
        "jsonParameters": true,
        "options": {},
        "sendBinaryData": false,
        "headerParametersJson": "={\n  \"Authorization\": \"Bearer \" + $items(\"Prepare_Payload\")[0].json.serviceRole,\n  \"apikey\": $items(\"Prepare_Payload\")[0].json.serviceRole,\n  \"Content-Type\": \"application/json\",\n  \"Prefer\": \"return=minimal\"\n}",
        "bodyParametersJson": "={{ $items(\"Normalize → staging_metric_facts\")[0].json.rows.map(r => ({ investee_id: r.investee_id, holding_id: r.holding_id, metric_code: r.metric_code, period_start: r.period_start, period_end: r.period_end, value: r.value, source: r.source, verification_level: r.verification_level, data_quality_score: r.data_quality_score, last_updated: r.last_updated })) }}"
      },
      "id": "Insert_Facts",
      "name": "Insert metric_facts (auto-approve)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [2660, 220]
    },
    {
      "parameters": {
        "requestMethod": "PATCH",
        "url": "={{ $items(\"Prepare_Payload\")[0].json.supabaseUrl }}/rest/v1/uploads?id=eq.{{$items(\"Prepare_Payload\")[0].json.uploadId}}",
        "jsonParameters": true,
        "options": {},
        "sendBinaryData": false,
        "headerParametersJson": "={\n  \"Authorization\": \"Bearer \" + $items(\"Prepare_Payload\")[0].json.serviceRole,\n  \"apikey\": $items(\"Prepare_Payload\")[0].json.serviceRole,\n  \"Content-Type\": \"application/json\"\n}",
        "bodyParametersJson": "{\"status\":\"done\"}"
      },
      "id": "Uploads_Done",
      "name": "Uploads → done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [2880, 300]
    },
    {
      "parameters": {
        "responseBody": "={{ { ok: true, uploadId: $items(\"Prepare_Payload\")[0].json.uploadId } }}",
        "responseCode": 200
      },
      "id": "Respond_OK",
      "name": "Respond (OK)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [3100, 300]
    },
    {
      "parameters": {
        "requestMethod": "PATCH",
        "url": "={{ $items(\"Prepare_Payload\")[0].json.supabaseUrl }}/rest/v1/uploads?id=eq.{{$items(\"Prepare_Payload\")[0].json.uploadId}}",
        "jsonParameters": true,
        "options": {},
        "sendBinaryData": false,
        "headerParametersJson": "={\n  \"Authorization\": \"Bearer \" + $items(\"Prepare_Payload\")[0].json.serviceRole,\n  \"apikey\": $items(\"Prepare_Payload\")[0].json.serviceRole,\n  \"Content-Type\": \"application/json\"\n}",
        "bodyParametersJson": "{\"status\":\"error\"}"
      },
      "id": "Uploads_Error",
      "name": "Uploads → error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [2660, 520]
    },
    {
      "parameters": {
        "responseBody": "={{ { ok:false, error:$json } }}",
        "responseCode": 500
      },
      "id": "Respond_Error",
      "name": "Respond (Error)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2880, 520]
    }
  ],
