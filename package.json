{
  "name": "benevolence-product",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "builder:worker": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/builder-worker.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "vercel-build": "next build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "walkthrough:doctor": "ts-node --project tsconfig.scripts.json scripts/walkthrough/doctor.ts",
    "walkthrough:setup": "ts-node --project tsconfig.scripts.json scripts/walkthrough/setup.ts",
    "walkthrough:reset": "ts-node --project tsconfig.scripts.json scripts/walkthrough/reset.ts",
    "walkthrough:seed": "ts-node --project tsconfig.scripts.json scripts/walkthrough/seed.ts",
    "walkthrough:dev": "ts-node --project tsconfig.scripts.json scripts/walkthrough/dev.ts",
    "walkthrough:test": "ts-node --project tsconfig.scripts.json scripts/walkthrough/run-tests.ts",
    "walkthrough:smoke": "ts-node --project tsconfig.scripts.json scripts/walkthrough/run-tests.ts tests/walkthrough/smoke",
    "walkthrough:journeys": "ts-node --project tsconfig.scripts.json scripts/walkthrough/run-tests.ts tests/walkthrough/journeys",
    "walkthrough:test:ui": "ts-node --project tsconfig.scripts.json scripts/walkthrough/run-tests.ts --ui",
    "setup": "bash scripts/setup-client.sh",
    "provision": "ts-node --project tsconfig.scripts.json scripts/provision-client.ts",
    "handoff": "ts-node --project tsconfig.scripts.json scripts/export-client-package.ts",
    "migrate-client": "ts-node --project tsconfig.scripts.json scripts/migrate-client.ts",
    "verify:types": "tsc --noEmit",
    "verify:lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=511",
    "verify:unit": "vitest run",
    "verify:migrations": "supabase db reset && bash scripts/verify/migrations-assert.sh",
    "verify:build": "next build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.68",
    "@anthropic-ai/sdk": "^0.74.0",
    "@heroicons/react": "^2.2.0",
    "@react-email/components": "^1.0.12",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.87.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/papaparse": "^5.5.2",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.6",
    "bullmq": "^5.71.1",
    "claude": "^0.1.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-shape": "^3.2.0",
    "intuit-oauth": "^4.2.2",
    "ioredis": "^5.10.1",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "next": "^15.5.0",
    "node-quickbooks": "^2.0.50",
    "openai": "^6.0.1",
    "papaparse": "^5.5.3",
    "pdf2json": "^3.2.2",
    "postcss": "^8.5.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.12.2",
    "supabase": "^2.47.2",
    "swr": "^2.3.6",
    "tailwindcss": "^4.1.12",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "xlsx": "^0.18.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/d3": "^7.4.3",
    "@types/node": "20.11.30",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "@types/topojson-client": "^3.1.5",
    "@vitest/ui": "^4.0.12",
    "eslint": "8.57.0",
    "eslint-config-next": "^15.5.12",
    "jsdom": "^27.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^3.15.0",
    "typescript": "5.5.4",
    "vitest": "^4.0.12"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
