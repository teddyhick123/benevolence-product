# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ==============================================================================


# ==============================================================================
# BRANDING (Optional - defaults provided in lib/config/branding.ts)
# ==============================================================================

# Application name displayed in UI
NEXT_PUBLIC_APP_NAME="Impact Platform"

# Company name for legal/footer
NEXT_PUBLIC_COMPANY_NAME="Your Organization"

# Short tagline
NEXT_PUBLIC_TAGLINE="Manage your impact portfolio"

# Support email
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourorg.com"

# Logo paths (relative to /public)
NEXT_PUBLIC_LOGO_PRIMARY="/logo.svg"
NEXT_PUBLIC_LOGO_LIGHT="/logo-light.svg"
NEXT_PUBLIC_LOGO_ICON="/icon.svg"

# Brand colors (should match tailwind.config.js if customized)
NEXT_PUBLIC_COLOR_PRIMARY="#5186a6"
NEXT_PUBLIC_COLOR_SECONDARY="#e07a5f"
NEXT_PUBLIC_COLOR_BACKGROUND="#fffff9"
NEXT_PUBLIC_COLOR_TEXT="#0f172a"

# AI Assistant names
NEXT_PUBLIC_ASSISTANT_NAME="Assistant"
NEXT_PUBLIC_ONBOARDING_ASSISTANT_NAME="Ben"


# ==============================================================================
# SUPABASE (Required)
# ==============================================================================
# Get these from your Supabase project: Settings > API

# Public URL (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Anonymous/public key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Service role key (server-side only - KEEP SECRET)
SUPABASE_SERVICE_ROLE="eyJ..."


# ==============================================================================
# ANTHROPIC / CLAUDE (Required for AI features)
# ==============================================================================
# Get from: https://console.anthropic.com/

ANTHROPIC_API_KEY="sk-ant-..."

# Organization-managed AI credentials are encrypted with AES-256-GCM and
# independently fingerprinted with HMAC-SHA-256. Each JSON value is a base64
# encoded 32-byte key. Keep the two key rings' material distinct.
AI_CREDENTIAL_ENCRYPTION_KEYS='{"v1":"<base64-encoded-32-byte-key>"}'
AI_CREDENTIAL_ACTIVE_ENCRYPTION_KEY_ID="v1"
AI_CREDENTIAL_FINGERPRINT_KEYS='{"v1":"<different-base64-encoded-32-byte-key>"}'
AI_CREDENTIAL_ACTIVE_FINGERPRINT_KEY_ID="v1"


# ==============================================================================
# QUICKBOOKS (Optional)
# ==============================================================================
# Get QB_CLIENT_ID and QB_CLIENT_SECRET from developer.intuit.com

QB_CLIENT_ID=""
QB_CLIENT_SECRET=""
QB_REDIRECT_URI=""
QB_ENVIRONMENT="sandbox"

# Required when QuickBooks is connected. Generate with: openssl rand -hex 32
QB_TOKEN_ENCRYPTION_KEY=""


# ==============================================================================
# OPTIONAL INTEGRATIONS
# ==============================================================================

# OpenAI (if using any OpenAI features)
OPENAI_API_KEY=""

# Google Maps (for location features)
GOOGLE_MAPS_API_KEY=""

# News API (for news integration)
NEWS_API_KEY=""

# Charity Navigator API
CHARITY_NAVIGATOR_API_KEY=""

# Candid/GuideStar API
CANDID_API_KEY=""


# ==============================================================================
# RATE LIMITING (Optional - Upstash Redis)
# ==============================================================================
# Get from: https://console.upstash.com/

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# ==============================================================================
# CRON JOBS (Vercel Cron)
# ==============================================================================
# Generate a strong random secret: openssl rand -hex 32
# Set this in Vercel project settings → Environment Variables.
# Vercel Cron passes it as: Authorization: Bearer <CRON_SECRET>

CRON_SECRET=""


# ==============================================================================
# BUILDER VERIFICATION (Required in production when Builder code proposals run)
# ==============================================================================

# Digest-pinned image built from docker/builder-verifier/Dockerfile by trusted
# CI. Production Builder workers fail closed rather than execute proposal code
# on the host when this is absent or not digest-pinned.
BUILDER_VERIFIER_IMAGE="registry.example.com/impact-builder-verifier@sha256:<64-hex-digest>"


# ==============================================================================
# DEFAULTS
# ==============================================================================

# Default portfolio ID (usually set after initial setup)
NEXT_PUBLIC_PORTFOLIO_ID_DEFAULT=""
