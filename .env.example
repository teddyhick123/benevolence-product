# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ==============================================================================


# ==============================================================================
# BRANDING (Optional - defaults provided in lib/config/branding.ts)
# ==============================================================================

# Application name displayed in UI
NEXT_PUBLIC_APP_NAME="Impact Platform"

# Company name for legal/footer
NEXT_PUBLIC_COMPANY_NAME="Your Organization"

# Short tagline
NEXT_PUBLIC_TAGLINE="Manage your impact portfolio"

# Support email
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourorg.com"

# Logo paths (relative to /public)
NEXT_PUBLIC_LOGO_PRIMARY="/logo.svg"
NEXT_PUBLIC_LOGO_LIGHT="/logo-light.svg"
NEXT_PUBLIC_LOGO_ICON="/icon.svg"

# Brand colors (should match tailwind.config.js if customized)
NEXT_PUBLIC_COLOR_PRIMARY="#5186a6"
NEXT_PUBLIC_COLOR_SECONDARY="#e07a5f"
NEXT_PUBLIC_COLOR_BACKGROUND="#fffff9"
NEXT_PUBLIC_COLOR_TEXT="#0f172a"

# AI Assistant names
NEXT_PUBLIC_ASSISTANT_NAME="Assistant"
NEXT_PUBLIC_ONBOARDING_ASSISTANT_NAME="Ben"


# ==============================================================================
# SUPABASE (Required)
# ==============================================================================
# Get these from your Supabase project: Settings > API

# Public URL (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Anonymous/public key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Service role key (server-side only - KEEP SECRET)
SUPABASE_SERVICE_ROLE="eyJ..."


# ==============================================================================
# ANTHROPIC / CLAUDE (Required for AI features)
# ==============================================================================
# Get from: https://console.anthropic.com/

ANTHROPIC_API_KEY="sk-ant-..."

# Organization-managed AI credentials are encrypted with AES-256-GCM and
# independently fingerprinted with HMAC-SHA-256. Each JSON value is a base64
# encoded 32-byte key. Keep the two key rings' material distinct.
AI_CREDENTIAL_ENCRYPTION_KEYS='{"v1":"<base64-encoded-32-byte-key>"}'
AI_CREDENTIAL_ACTIVE_ENCRYPTION_KEY_ID="v1"
AI_CREDENTIAL_FINGERPRINT_KEYS='{"v1":"<different-base64-encoded-32-byte-key>"}'
AI_CREDENTIAL_ACTIVE_FINGERPRINT_KEY_ID="v1"


# ==============================================================================
# QUICKBOOKS (Optional)
# ==============================================================================
# Get QB_CLIENT_ID and QB_CLIENT_SECRET from developer.intuit.com

QB_CLIENT_ID=""
QB_CLIENT_SECRET=""
QB_REDIRECT_URI=""
QB_ENVIRONMENT="sandbox"

# Required when QuickBooks is connected. Generate with: openssl rand -hex 32
QB_TOKEN_ENCRYPTION_KEY=""


# ==============================================================================
# OPTIONAL INTEGRATIONS
# ==============================================================================

# OpenAI (if using any OpenAI features)
OPENAI_API_KEY=""

# Google Maps (for location features)
GOOGLE_MAPS_API_KEY=""

# News API (for news integration)
NEWS_API_KEY=""

# Charity Navigator API
CHARITY_NAVIGATOR_API_KEY=""

# Candid/GuideStar API
CANDID_API_KEY=""


# ==============================================================================
# RATE LIMITING (Optional - Upstash Redis)
# ==============================================================================
# Get from: https://console.upstash.com/

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# ==============================================================================
# CRON JOBS (Vercel Cron)
# ==============================================================================
# Generate a strong random secret: openssl rand -hex 32
# Set this in Vercel project settings → Environment Variables.
# Vercel Cron passes it as: Authorization: Bearer <CRON_SECRET>

CRON_SECRET=""


# ==============================================================================
# BUILDER VERIFICATION (Required in production when Builder code proposals run)
# ==============================================================================

# Digest-pinned image built from docker/builder-verifier/Dockerfile by trusted
# CI. Production Builder workers fail closed rather than execute proposal code
# on the host when this is absent or not digest-pinned.
BUILDER_VERIFIER_IMAGE="registry.example.com/impact-builder-verifier@sha256:<64-hex-digest>"


# ==============================================================================
# BUILDER DELIVERY (Required for Builder code proposals to open pull requests)
# ==============================================================================
# Fine-grained PAT with Contents: Read and write + Pull requests: Read and write
# on the target repository. Without all three values, Builder proposals reach
# ready_to_apply and then fail at the apply step.

GITHUB_TOKEN=""
GITHUB_REPO_OWNER=""
GITHUB_REPO_NAME=""


# ==============================================================================
# BUILDER WORKER QUEUE (Required wherever the Builder worker runs)
# ==============================================================================
# BullMQ connection for `npm run builder:worker`. Defaults to
# redis://localhost:6379 when unset, which silently fails in a hosted instance.

REDIS_URL="redis://localhost:6379"


# ==============================================================================
# AI MODEL SELECTION (Optional - platform defaults live in lib/ai/models.ts)
# ==============================================================================

# Provider used when a caller does not name one. Unset means "anthropic".
AI_PROVIDER="anthropic"

# Per-workload overrides of the platform default model. Leave unset to track
# the defaults in lib/ai/models.ts; a stale pin here silently keeps an instance
# on an older model after the platform default moves.
AI_MODEL_ASSISTANT=""
AI_MODEL_SCAFFOLD_PLAN=""
AI_MODEL_SCAFFOLD_BUILD=""
AI_MODEL_SCAFFOLD_REVIEW=""

# Audio transcription model for the transcription workload. Unset means
# "whisper-1"; a value naming a model the configured provider does not serve
# fails at request time, not at boot.
TRANSCRIPTION_MODEL=""


# ==============================================================================
# BRANDING LINKS (Optional - defaults provided in lib/config/branding.ts)
# ==============================================================================

# Absolute base URL of this instance. CPA share links and invitation emails
# build absolute URLs from it; unset makes invitation links point at
# http://localhost:3000 and CPA share-link generation fail.
NEXT_PUBLIC_APP_URL=""

# Footer legal links. Unset falls back to the in-app /privacy and /terms pages.
NEXT_PUBLIC_PRIVACY_URL=""
NEXT_PUBLIC_TERMS_URL=""

# Footer social links. Unset renders no icon for that network.
NEXT_PUBLIC_SOCIAL_TWITTER=""
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
NEXT_PUBLIC_SOCIAL_WEBSITE=""


# ==============================================================================
# TRANSACTIONAL EMAIL (Required for invitations, digests, and notifications)
# ==============================================================================
# Get from: https://resend.com/api-keys

# Without a key, invitation emails, notification delivery, and digest sends all
# fail — the outbox rows are written but never delivered.
RESEND_API_KEY=""

# Verified sending domain. Unset falls back to "resend.dev", which is
# rate-limited and unsuitable for a client instance.
RESEND_FROM_DOMAIN=""


# ==============================================================================
# PROVISIONING & MIGRATION SCRIPTS (Required only for scripts/, not the app)
# ==============================================================================
# Used by scripts/provision-client.ts and scripts/migrate-client.ts to create
# and migrate a client's Supabase project via the Management API.

# Supabase Management API personal access token.
SUPABASE_ACCESS_TOKEN=""

# Supabase organization that new client projects are created under.
SUPABASE_ORG_ID=""

# Project ref of the instance the Constructor chat introspects.
SUPABASE_PROJECT_REF=""

# Target project URL and service key for scripts/migrate-client.ts. These are
# the script-side equivalents of NEXT_PUBLIC_SUPABASE_URL and
# SUPABASE_SERVICE_ROLE above; see NOTE below about the key naming.
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# NOTE: lib/services/google-maps.ts reads SUPABASE_SERVICE_ROLE_KEY while the
# rest of the application reads SUPABASE_SERVICE_ROLE. Set both to the same
# service role key until that inconsistency is resolved; leaving this one unset
# disables the geocode cache write path without an error.
SUPABASE_SERVICE_ROLE_KEY=""


# ==============================================================================
# DEMO DATA (Optional)
# ==============================================================================

# Gates POST /api/admin/demo/load in production. Must be exactly "true" to
# permit demo seeding on a production deployment; unset blocks it.
ENABLE_DEMO_DATA_API=""


# ==============================================================================
# DEFAULTS
# ==============================================================================

# Geocoding queries per second against the Google Maps API. Unset means 50.
GEOCODING_RATE_LIMIT_QPS=""

# Default portfolio ID (usually set after initial setup)
NEXT_PUBLIC_PORTFOLIO_ID_DEFAULT=""
