# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ==============================================================================


# ==============================================================================
# BRANDING (Optional - defaults provided in lib/config/branding.ts)
# ==============================================================================

# Application name displayed in UI
NEXT_PUBLIC_APP_NAME="Impact Platform"

# Company name for legal/footer
NEXT_PUBLIC_COMPANY_NAME="Your Organization"

# Short tagline
NEXT_PUBLIC_TAGLINE="Manage your impact portfolio"

# Support email
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourorg.com"

# Logo paths (relative to /public)
NEXT_PUBLIC_LOGO_PRIMARY="/logo.svg"
NEXT_PUBLIC_LOGO_LIGHT="/logo-light.svg"
NEXT_PUBLIC_LOGO_ICON="/icon.svg"

# Brand colors (should match tailwind.config.js if customized)
NEXT_PUBLIC_COLOR_PRIMARY="#5186a6"
NEXT_PUBLIC_COLOR_SECONDARY="#e07a5f"
NEXT_PUBLIC_COLOR_BACKGROUND="#fffff9"
NEXT_PUBLIC_COLOR_TEXT="#0f172a"

# AI Assistant names
NEXT_PUBLIC_ASSISTANT_NAME="Assistant"
NEXT_PUBLIC_ONBOARDING_ASSISTANT_NAME="Ben"


# ==============================================================================
# SUPABASE (Required)
# ==============================================================================
# Get these from your Supabase project: Settings > API

# Public URL (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Anonymous/public key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Service role key (server-side only - KEEP SECRET)
SUPABASE_SERVICE_ROLE="eyJ..."


# ==============================================================================
# ANTHROPIC / CLAUDE (Required for AI features)
# ==============================================================================
# Get from: https://console.anthropic.com/

ANTHROPIC_API_KEY="sk-ant-..."


# ==============================================================================
# OPTIONAL INTEGRATIONS
# ==============================================================================

# OpenAI (if using any OpenAI features)
OPENAI_API_KEY=""

# Google Maps (for location features)
GOOGLE_MAPS_API_KEY=""

# News API (for news integration)
NEWS_API_KEY=""

# Charity Navigator API
CHARITY_NAVIGATOR_API_KEY=""

# Candid/GuideStar API
CANDID_API_KEY=""


# ==============================================================================
# RATE LIMITING (Optional - Upstash Redis)
# ==============================================================================
# Get from: https://console.upstash.com/

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# ==============================================================================
# DEFAULTS
# ==============================================================================

# Default portfolio ID (usually set after initial setup)
NEXT_PUBLIC_PORTFOLIO_ID_DEFAULT=""
